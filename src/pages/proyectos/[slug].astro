---
import { Icon } from 'astro-icon/components';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectMedia from '../../components/ProjectMedia.astro';
import { accentClasses, projectHref, projects, projectsIndexHref, sectionHref } from '../../data/profile';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const accent = accentClasses[project.accent];
const currentIndex = projects.findIndex((item) => item.id === project.id);
const previous = currentIndex > 0 ? projects[currentIndex - 1] : undefined;
const next = currentIndex < projects.length - 1 ? projects[currentIndex + 1] : undefined;
---

<BaseLayout
  title={`${project.title} — Nestor Ospina`}
  description={project.description}
>
  <article class="relative min-h-screen px-4 pb-24 pt-32 sm:px-6 lg:px-8">
    <div class="mx-auto max-w-5xl">
      <div class="flex flex-wrap items-center justify-between gap-4">
        <a href={projectsIndexHref()} class="label inline-flex items-center gap-2 transition-colors hover:text-neon">
          <Icon name="lucide:arrow-left" class="h-3.5 w-3.5" />
          all cases
        </a>
        <a href={sectionHref('contact')} class="btn btn-ghost !px-3 !py-2">
          Contact
          <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5" />
        </a>
      </div>

      <header class="mt-10 border-b border-hud pb-8">
        <div class="flex flex-wrap items-start gap-5">
          <span class={`grid h-14 w-14 shrink-0 place-items-center rounded border ${accent.border} ${accent.bg} ${accent.text}`}>
            <Icon name={project.icon} class="h-7 w-7" />
          </span>
          <div>
            <p class={`label ${accent.text}`}>{project.category}</p>
            <h1 class="mt-2 font-display text-4xl font-bold uppercase leading-[0.95] tracking-tight text-txt sm:text-6xl">{project.title}</h1>
            <p class={`mt-3 font-mono text-xs uppercase tracking-[0.16em] ${accent.text}`}>{project.subtitle}</p>
            {project.context && <p class="mt-3 max-w-3xl font-mono text-xs leading-relaxed text-txt-mute">{project.context}</p>}
          </div>
        </div>
        <p class="mt-7 max-w-4xl text-lg leading-relaxed text-txt-dim">{project.description}</p>
      </header>

      <div class="mt-10 grid gap-10 lg:grid-cols-[minmax(0,1fr)_18rem]">
        <div>
          <section>
            <p class="label">// scope</p>
            <p class="mt-3 rounded border-l-2 border-amber/60 bg-amber/[0.06] px-4 py-4 text-sm leading-relaxed text-txt">{project.scope}</p>
          </section>

          <section class="mt-10">
            <p class="label">// technical approach</p>
            <ol class="mt-4 space-y-4">
              {project.approach.map((step, index) => (
                <li class="flex items-start gap-3">
                  <span class={`mono grid h-7 w-7 shrink-0 place-items-center rounded border ${accent.border} ${accent.bg} text-[10px] font-bold ${accent.text}`}>{String(index + 1).padStart(2, '0')}</span>
                  <span class="text-sm leading-relaxed text-txt">{step}</span>
                </li>
              ))}
            </ol>
          </section>

          <ProjectMedia slug={project.id} />
        </div>

        <aside class="space-y-5">
          <div class="panel corners p-5">
            <p class="label">key highlights</p>
            <div class="mt-4 space-y-3">
              {project.highlights.map((highlight) => (
                <div class={`rounded border ${accent.border} ${accent.bg} px-3 py-3`}>
                  <p class={`mono text-lg font-bold ${accent.text}`}>{highlight.value}</p>
                  <p class="label mt-1 !text-[9px]">{highlight.label}</p>
                </div>
              ))}
            </div>
          </div>
          <div class="panel corners p-5">
            <p class="label">tech stack</p>
            <div class="mt-4 flex flex-wrap gap-2">
              {project.stack.map((item) => <span class="chip">{item}</span>)}
            </div>
          </div>
        </aside>
      </div>

      <nav class="mt-14 grid gap-4 border-t border-hud pt-6 sm:grid-cols-2" aria-label="Navigate between cases">
        {previous ? (
          <a href={projectHref(previous.id)} class="panel corners group p-4 transition-colors hover:border-cyan/50">
            <p class="label">previous case</p>
            <p class="mt-2 font-mono text-sm text-txt transition-colors group-hover:text-cyan">← {previous.title}</p>
          </a>
        ) : <span></span>}
        {next && (
          <a href={projectHref(next.id)} class="panel corners group p-4 text-right transition-colors hover:border-neon/50">
            <p class="label">next case</p>
            <p class="mt-2 font-mono text-sm text-txt transition-colors group-hover:text-neon">{next.title} →</p>
          </a>
        )}
      </nav>
    </div>
  </article>
</BaseLayout>

---
import '../styles/global.css';
import Background from '../components/Background.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { profile } from '../data/profile';
import { translations, defaultLang } from '../data/translations';
import type { Lang } from '../data/translations';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.tagline,
} = Astro.props;

const site = Astro.site?.origin ?? 'https://niospinag.github.io';
const publicAsset = (path: string) =>
  `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
const ogImage = new URL(publicAsset('/og-cover.png'), site).href;
const canonical = Astro.url.href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: profile.name,
  jobTitle: profile.role,
  description: profile.tagline,
  email: `mailto:${profile.email}`,
  telephone: profile.phoneHref,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Bogotá',
    addressCountry: 'CO',
  },
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Universidad Nacional de Colombia',
    },
  ],
  hasCredential: {
    '@type': 'EducationalOccupationalCredential',
    name: 'PMP — Project Management Professional',
  },
  knowsAbout: [
    'Robotics',
    'ROS',
    'Control Algorithms',
    'Autonomous Navigation',
    'CAD Design',
    'SolidWorks',
    'Embedded Systems',
    'Fleet Analytics',
  ],
  sameAs: [profile.links.github, profile.links.linkedin],
  url: canonical,
};
---

<!doctype html>
<html lang="en" class="dark scroll-smooth">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#04070a" />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow" />

    <!-- Open Graph / Twitter -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={`${profile.shortName} — Robotics`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${profile.name} — ${profile.role}`} />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Icons -->
    <link rel="icon" type="image/svg+xml" href={publicAsset('/favicon.svg')} />
    <link rel="apple-touch-icon" href={publicAsset('/favicon.svg')} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>

  <body class="relative min-h-screen antialiased">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[100] focus:rounded focus:bg-neon focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:font-bold focus:text-void"
    >
      Skip to content
    </a>

    <Background />
    <Nav />

    <main id="main" class="relative z-10">
      <slot />
    </main>

    <Footer />

    <!-- Back to top -->
    <button
      id="to-top"
      type="button"
      aria-label="Volver arriba"
      class="group fixed bottom-6 right-6 z-40 grid h-11 w-11 translate-y-4 place-items-center rounded border border-hud bg-panel/80 text-txt-dim opacity-0 backdrop-blur transition-all duration-300 hover:border-neon/60 hover:text-neon focus-visible:opacity-100 data-[show=true]:translate-y-0 data-[show=true]:opacity-100"
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="h-4 w-4 transition-transform group-hover:-translate-y-0.5">
        <path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
    </button>
  </body>
</html>

<script>
  /* ------------------------------------------------------------------
   * Global telemetry UI: scroll progress, section spy, reveal-on-scroll,
   * live UTC-5 clock, back-to-top. Vanilla JS, no framework weight.
   * ------------------------------------------------------------------ */

  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* Scroll progress bar (top of viewport) */
  const progress = document.getElementById('scroll-progress');
  const onScroll = () => {
    const h = document.documentElement;
    const max = h.scrollHeight - h.clientHeight;
    const p = max > 0 ? (h.scrollTop / max) * 100 : 0;
    if (progress) progress.style.transform = `scaleX(${p / 100})`;
    const top = document.getElementById('to-top');
    top?.setAttribute('data-show', String(h.scrollTop > 640));
  };
  document.addEventListener('scroll', onScroll, { passive: true });
  onScroll();

  document.getElementById('to-top')?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: reduce ? 'auto' : 'smooth' });
  });

  /* Reveal-on-scroll */
  const revealables = document.querySelectorAll<HTMLElement>('.reveal');
  if (reduce || !('IntersectionObserver' in window)) {
    revealables.forEach((el) => el.classList.add('is-visible'));
  } else {
    const ro = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            e.target.classList.add('is-visible');
            ro.unobserve(e.target);
          }
        }
      },
      { threshold: 0.12, rootMargin: '0px 0px -8% 0px' },
    );
    revealables.forEach((el) => ro.observe(el));
  }

  /* Section spy -> highlight active nav link */
  const links = new Map<string, HTMLElement>();
  document.querySelectorAll<HTMLAnchorElement>('[data-navlink]').forEach((a) => {
    const id = new URL(a.href, window.location.origin).hash.slice(1);
    if (id) links.set(id, a);
  });
  const sections = [...links.keys()]
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLElement => Boolean(el));

  if ('IntersectionObserver' in window && sections.length) {
    const spy = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          links.forEach((el, id) => {
            el.setAttribute('data-active', String(id === e.target.id));
          });
        }
      },
      { rootMargin: '-45% 0px -50% 0px' },
    );
    sections.forEach((s) => spy.observe(s));
  }

  /* Live Bogotá clock (UTC-5) in the HUD bar */
  const clock = document.getElementById('hud-clock');
  if (clock) {
    const fmt = new Intl.DateTimeFormat('es-CO', {
      timeZone: 'America/Bogota',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      hour12: false,
    });
    const tick = () => {
      clock.textContent = fmt.format(new Date());
    };
    tick();
    window.setInterval(tick, 1000);
  }

  /* ------------------------------------------------------------------
   * Language Toggle (i18n)
   * ------------------------------------------------------------------ */
  type TranslationKey = keyof typeof translations.en;

  const STORAGE_KEY = 'portfolio-lang';
  const langLabel = document.getElementById('lang-label');

  const getLang = (): Lang => {
    const stored = localStorage.getItem(STORAGE_KEY);
    if (stored === 'en' || stored === 'es') return stored;
    const browser = navigator.language.slice(0, 2);
    if (browser === 'es') return 'es';
    return defaultLang;
  };

  const setLang = (lang: Lang) => {
    localStorage.setItem(STORAGE_KEY, lang);
    document.documentElement.lang = lang;
    applyTranslations(lang);
    if (langLabel) langLabel.textContent = lang.toUpperCase();
  };

  const applyTranslations = (lang: Lang) => {
    const t = translations[lang];

    document.querySelectorAll('[data-i18n]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18n as string;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t);
      if (value) {
        if (el instanceof HTMLInputElement) {
          el.placeholder = value;
        } else {
          el.textContent = value;
        }
      }
    });

    document.querySelectorAll('[data-i18n-nav]').forEach((el) => {
      const text = el.textContent?.trim().toLowerCase();
      if (text && t.nav[text as keyof typeof t.nav]) {
        el.textContent = t.nav[text as keyof typeof t.nav];
      }
    });

    document.querySelectorAll('[data-i18n-hero-status]').forEach((el) => {
      el.textContent = t.hero.status;
    });

    document.querySelectorAll('[data-i18n-cta]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18nCta as string;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t.footer);
      if (value) el.textContent = value;
    });

    document.querySelectorAll('[data-i18n-about]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18nAbout as string;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t.about);
      if (value) el.textContent = value;
    });

    document.querySelectorAll('[data-i18n-stack]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18nStack as string;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t.stack);
      if (value) el.textContent = value;
    });

    document.querySelectorAll('[data-i18n-exp]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18nExp as string;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t.experience);
      if (value) el.textContent = value;
    });

    document.querySelectorAll('[data-i18n-viewer]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18nViewer as string;
      const value = key.split('.').reduce((obj: any, k) => obj?.[k], t.viewer);
      if (value) el.textContent = value;
    });

    document.querySelectorAll('[data-i18n-project-card]').forEach((el) => {
      el.textContent = t.projects.viewFull;
    });

    document.querySelectorAll('[data-i18n-footer-cta]').forEach((el) => {
      el.textContent = t.footer.ctaTitle;
    });

    document.querySelectorAll('[data-i18n-copy-email]').forEach((el) => {
      el.textContent = t.footer.copyEmail;
    });

    document.querySelectorAll('[data-i18n-toast]').forEach((el) => {
      el.textContent = t.footer.emailCopied;
    });

    document.querySelectorAll('[data-i18n-back-top]').forEach((el) => {
      el.textContent = t.footer.backToTop;
    });

    document.querySelectorAll('[data-i18n-section-title]').forEach((el) => {
      const section = (el as HTMLElement).dataset.i18nSectionTitle as string;
      if (section === 'experience') el.textContent = t.experience.title;
      if (section === 'projects') el.textContent = t.projects.title;
      if (section === 'stack') el.textContent = t.stack.title;
      if (section === 'about') el.textContent = t.about.title;
      if (section === 'viewer') el.textContent = t.viewer.title;
    });

    document.querySelectorAll('[data-i18n-subtitle]').forEach((el) => {
      const section = (el as HTMLElement).dataset.i18nSubtitle as string;
      if (section === 'experience') el.textContent = t.experience.subtitle;
      if (section === 'projects') el.textContent = t.projects.subtitle;
      if (section === 'stack') el.textContent = t.stack.subtitle;
      if (section === 'about') el.textContent = t.about.subtitle;
      if (section === 'viewer') el.textContent = t.viewer.subtitle;
    });

    document.querySelectorAll('[data-i18n-label]').forEach((el) => {
      const key = (el as HTMLElement).dataset.i18nLabel as string;
      if (key === 'education') el.textContent = t.about.education;
      if (key === 'languages') el.textContent = t.about.languages;
      if (key === 'certifications') el.textContent = t.about.certifications;
      if (key === 'quickRecord') el.textContent = t.about.quickRecord;
      if (key === 'references') el.textContent = t.about.references;
      if (key === 'galleryTitle') el.textContent = t.viewer.gallery;
      if (key === 'galleryText') el.textContent = t.viewer.galleryText;
      if (key === 'availableAssemblies') el.textContent = t.viewer.availableAssemblies;
      if (key === 'technicalSpecs') el.textContent = t.viewer.technicalSpecs;
      if (key === 'assetPath') el.textContent = t.viewer.assetPath;
    });

    document.querySelectorAll('[data-i18n-open-channel]').forEach((el) => {
      el.textContent = t.footer.openChannel;
    });

    document.querySelectorAll('[data-i18n-cta-text]').forEach((el) => {
      el.textContent = t.footer.ctaText;
    });

    document.querySelectorAll('[data-i18n-pdf-cv]').forEach((el) => {
      el.textContent = t.footer.pdfCV;
    });

    document.querySelectorAll('[data-i18n-projects-title]').forEach((el) => {
      el.textContent = t.projects.title;
    });

    document.querySelectorAll('[data-i18n-projects-subtitle]').forEach((el) => {
      el.textContent = t.projects.subtitle;
    });

    document.querySelectorAll('[data-i18n-projects-link]').forEach((el) => {
      el.textContent = t.projects.viewAll;
    });

    document.querySelectorAll('[data-i18n-current]').forEach((el) => {
      el.textContent = t.experience.current;
    });

    document.querySelectorAll('[data-i18n-screenshot-count]').forEach((el) => {
      el.textContent = `${t.viewer.screenshots}`;
    });

    document.querySelectorAll('[data-i18n-model-count]').forEach((el) => {
      el.textContent = `${t.viewer.models}`;
    });

    document.querySelectorAll('[data-i18n-404-title]').forEach((el) => {
      el.textContent = t.notFound.routeOut;
    });

    document.querySelectorAll('[data-i18n-404-text]').forEach((el) => {
      el.textContent = t.notFound.routeOutText;
    });

    document.querySelectorAll('[data-i18n-404-back]').forEach((el) => {
      el.textContent = t.notFound.backToHome;
    });

    document.querySelectorAll('[data-i18n-404-projects]').forEach((el) => {
      el.textContent = t.notFound.viewProjects;
    });

    document.querySelectorAll('[data-i18n-404-recovery]').forEach((el) => {
      el.textContent = t.notFound.recovering;
    });
  };

  document.getElementById('lang-toggle')?.addEventListener('click', () => {
    const current = getLang();
    setLang(current === 'en' ? 'es' : 'en');
  });

  setLang(getLang());
</script>

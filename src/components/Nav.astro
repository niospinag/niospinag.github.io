---
import { Icon } from 'astro-icon/components';
import { nav, profile } from '../data/profile';
---

<header
  class="fixed inset-x-0 top-0 z-50 border-b border-hud/70 bg-void/80 backdrop-blur-md supports-[backdrop-filter]:bg-void/60"
>
  <!-- scroll progress -->
  <div class="absolute inset-x-0 top-0 h-[2px] overflow-hidden">
    <div
      id="scroll-progress"
      class="h-full origin-left scale-x-0 bg-[linear-gradient(90deg,var(--color-neon),var(--color-cyan))] shadow-[0_0_10px_rgba(61,255,158,0.8)]"
    ></div>
  </div>

  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-4 sm:px-6 lg:px-8">
    <!-- brand -->
    <a href="#hero" data-navlink class="group flex items-center gap-3" aria-label="Ir al inicio">
      <span class="relative grid h-9 w-9 place-items-center rounded border border-hud bg-panel transition-colors group-hover:border-neon/60">
        <svg viewBox="0 0 64 64" class="h-5 w-5" aria-hidden="true">
          <path d="M32 6l22 13v26L32 58 10 45V19z" fill="none" stroke="currentColor" stroke-width="4" class="text-cyan" />
          <circle cx="32" cy="32" r="8" class="fill-neon" />
        </svg>
        <span class="absolute -right-1 -top-1 h-1.5 w-1.5 rounded-full bg-neon shadow-[0_0_8px_var(--color-neon)]"></span>
      </span>
      <span class="hidden leading-tight sm:block">
        <span class="block font-mono text-[13px] font-bold tracking-tight text-txt">
          {profile.shortName.toUpperCase()}
        </span>
        <span class="label block text-[9px] text-txt-mute">ROBOTICS · CONTROL · CAD</span>
      </span>
    </a>

    <!-- desktop nav -->
    <nav class="ml-auto hidden items-center gap-1 lg:flex" aria-label="Navegación principal">
      {
        nav.map((item) => (
          <a
            href={`#${item.id}`}
            data-navlink
            class="group relative rounded px-3 py-2 font-mono text-[11px] uppercase tracking-[0.14em] text-txt-dim transition-colors hover:text-neon data-[active=true]:text-neon"
          >
            <span class="mr-1 text-[9px] text-txt-mute transition-colors group-hover:text-neon/70">{item.index}</span>
            {item.label}
            <span class="absolute inset-x-3 -bottom-px h-px scale-x-0 bg-neon shadow-[0_0_8px_var(--color-neon)] transition-transform duration-300 group-hover:scale-x-100 data-[active=true]:scale-x-100"></span>
          </a>
        ))
      }
    </nav>

    <!-- right cluster -->
    <div class="ml-auto flex items-center gap-2 lg:ml-4">
      <span class="hidden items-center gap-2 rounded border border-hud bg-panel/70 px-2.5 py-1.5 font-mono text-[10px] text-txt-dim xl:flex">
        <span class="relative flex h-1.5 w-1.5">
          <span class="absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-neon opacity-75"></span>
          <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-neon"></span>
        </span>
        <span id="hud-clock" class="tabular-nums">--:--:--</span>
        <span class="text-txt-mute">BOG</span>
      </span>

      <a
        href={profile.links.github}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="GitHub"
        class="grid h-9 w-9 place-items-center rounded border border-hud bg-panel/70 text-txt-dim transition-all hover:-translate-y-0.5 hover:border-neon/50 hover:text-neon"
      >
        <Icon name="lucide:github" class="h-4 w-4" />
      </a>
      <a
        href={profile.links.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        aria-label="LinkedIn"
        class="grid h-9 w-9 place-items-center rounded border border-hud bg-panel/70 text-txt-dim transition-all hover:-translate-y-0.5 hover:border-cyan/50 hover:text-cyan"
      >
        <Icon name="lucide:linkedin" class="h-4 w-4" />
      </a>
      <a href={profile.cv} download class="btn btn-primary hidden !px-3.5 !py-2 md:inline-flex">
        <Icon name="lucide:download" class="h-3.5 w-3.5" />
        CV
      </a>

      <!-- mobile toggle -->
      <button
        id="nav-toggle"
        type="button"
        data-open="false"
        aria-expanded="false"
        aria-controls="mobile-menu"
        class="grid h-9 w-9 place-items-center rounded border border-hud bg-panel/70 text-txt-dim transition-colors hover:text-neon lg:hidden"
      >
        <Icon name="lucide:menu" class="h-4 w-4 [button[data-open='true']_&]:hidden" />
        <Icon name="lucide:x" class="hidden h-4 w-4 [button[data-open='true']_&]:block" />
      </button>
    </div>
  </div>

  <!-- mobile menu -->
  <div
    id="mobile-menu"
    class="hidden border-t border-hud/70 bg-void/95 backdrop-blur-md lg:hidden"
  >
    <nav class="mx-auto grid max-w-7xl gap-1 px-4 py-4 sm:px-6" aria-label="Navegación móvil">
      {
        nav.map((item) => (
          <a
            href={`#${item.id}`}
            data-navlink
            data-mobilelink
            class="flex items-center gap-3 rounded border border-transparent px-3 py-2.5 font-mono text-xs uppercase tracking-[0.16em] text-txt-dim transition-colors hover:border-hud hover:bg-panel hover:text-neon"
          >
            <span class="text-[10px] text-txt-mute">{item.index}</span>
            {item.label}
          </a>
        ))
      }
      <a href={profile.cv} download class="btn btn-primary mt-2 w-full">
        <Icon name="lucide:download" class="h-4 w-4" />
        Descargar CV
      </a>
    </nav>
  </div>
</header>

<script>
  const toggle = document.getElementById('nav-toggle');
  const menu = document.getElementById('mobile-menu');

  const setOpen = (open: boolean) => {
    menu?.classList.toggle('hidden', !open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('data-open', String(open));
  };

  toggle?.addEventListener('click', () => {
    setOpen(toggle.getAttribute('aria-expanded') !== 'true');
  });

  document.querySelectorAll('[data-mobilelink]').forEach((a) => {
    a.addEventListener('click', () => setOpen(false));
  });

  window.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') setOpen(false);
  });
</script>

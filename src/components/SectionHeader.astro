---
import type { Accent } from '../data/profile';
import { accentClasses } from '../data/profile';

interface Props {
  index: string;
  title: string;
  subtitle?: string;
  note?: string;
  accent?: Accent;
  i18nTitle?: string;
  i18nSubtitle?: string;
}

const { index, title, subtitle, note, accent = 'neon', i18nTitle, i18nSubtitle } = Astro.props;
const a = accentClasses[accent];
---

<div class="reveal mb-10 sm:mb-14">
  <div class="flex flex-wrap items-end justify-between gap-x-8 gap-y-3">
    <div class="min-w-0">
      <div class="flex items-center gap-3">
        <span class={`mono text-[11px] font-bold tracking-[0.2em] ${a.text}`}>[{index}]</span>
        <span class="h-px w-10 bg-gradient-to-r from-current to-transparent opacity-60" style={`color: var(--color-${accent})`}></span>
        {note && <span class="label">{note}</span>}
      </div>
      <h2 class="mt-3 text-3xl font-bold uppercase tracking-tight text-txt sm:text-4xl lg:text-[2.75rem]" data-i18n-section-title={i18nTitle}>
        {title}
      </h2>
      {subtitle && <p class="mt-3 max-w-2xl text-sm leading-relaxed text-txt-dim sm:text-base" data-i18n-subtitle={i18nSubtitle}>{subtitle}</p>}
    </div>
    <div class="mono hidden shrink-0 items-center gap-2 text-[10px] text-txt-mute sm:flex">
      <span class={`h-1.5 w-1.5 rounded-full ${a.dot} animate-blink`}></span>
      <span>SECTION::{index}</span>
      <span class="text-hud-hot">|</span>
      <span>RENDER:OK</span>
    </div>
  </div>
  <div class="mt-6 h-px w-full bg-[linear-gradient(90deg,var(--color-hud),transparent)]"></div>
</div>

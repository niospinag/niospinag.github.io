---
import { Icon } from 'astro-icon/components';
import type { Project } from '../data/profile';
import { accentClasses, projectHref } from '../data/profile';

interface Props {
  project: Project;
  delay?: number;
}

const { project, delay = 0 } = Astro.props;
const accent = accentClasses[project.accent];
---

<article
  class="panel corners reveal group relative flex flex-col overflow-hidden transition-all duration-300 hover:-translate-y-1.5 hover:border-hud-hot"
  style={`--reveal-delay:${delay}ms`}
>
  <div class={`absolute inset-x-0 top-0 h-px bg-gradient-to-r ${accent.grad} to-transparent opacity-60 transition-opacity group-hover:opacity-100`}></div>

  <a href={projectHref(project.id)} class="flex h-full flex-col p-5 text-left sm:p-6">
    <div class="flex items-start justify-between gap-4">
      <span class={`grid h-11 w-11 shrink-0 place-items-center rounded border ${accent.border} ${accent.bg} ${accent.text} transition-transform duration-300 group-hover:scale-105`}>
        <Icon name={project.icon} class="h-5 w-5" />
      </span>
      <span class={`label block !text-[9px] ${accent.text}`}>{project.category}</span>
    </div>

    <h3 class="mt-5 font-display text-xl font-bold leading-tight text-txt transition-colors group-hover:text-neon sm:text-2xl">
      {project.title}
    </h3>
    <p class={`mt-1 font-mono text-[11px] uppercase tracking-[0.14em] ${accent.text}`}>{project.subtitle}</p>

    {project.context && <p class="mt-3 font-mono text-[10px] leading-relaxed text-txt-mute">{project.context}</p>}
    <p class="mt-4 text-sm leading-relaxed text-txt-dim">{project.description}</p>

    <div class="mt-5 grid grid-cols-3 gap-2">
      {project.highlights.map((highlight) => (
        <div class="rounded border border-hud bg-panel-2/60 px-2 py-2 text-center">
          <span class={`mono block text-[11px] font-bold tabular-nums ${accent.text}`}>{highlight.value}</span>
          <span class="label mt-1 block !text-[8px] leading-tight">{highlight.label}</span>
        </div>
      ))}
    </div>

    <div class="mt-5 flex flex-wrap gap-1.5">
      {project.stack.slice(0, 5).map((item) => <span class="chip !px-2 !py-1 !text-[10px]">{item}</span>)}
      {project.stack.length > 5 && <span class="chip !px-2 !py-1 !text-[10px] text-txt-mute">+{project.stack.length - 5}</span>}
    </div>

    <span class="mt-auto flex items-center gap-2 pt-6 font-mono text-[11px] uppercase tracking-[0.16em] text-txt-mute transition-colors group-hover:text-neon">
      View full case
      <Icon name="lucide:arrow-up-right" class="h-3.5 w-3.5 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5" />
    </span>
  </a>
</article>

---
import { Icon } from 'astro-icon/components';
import type { Metric } from '../data/profile';
import { accentClasses } from '../data/profile';

interface Props {
  metric: Metric;
  delay?: number;
}

const { metric, delay = 0 } = Astro.props;
const a = accentClasses[metric.accent];
---

<article
  class="panel corners reveal group relative overflow-hidden p-4 transition-transform duration-300 hover:-translate-y-1 sm:p-5"
  style={`--reveal-delay:${delay}ms`}
>
  <!-- accent wash -->
  <div class={`pointer-events-none absolute inset-0 bg-gradient-to-br ${a.grad} to-transparent opacity-0 transition-opacity duration-300 group-hover:opacity-100`}></div>

  <div class="relative flex items-start justify-between gap-3">
    <span class={`mono text-3xl font-bold tabular-nums tracking-tight sm:text-4xl ${a.text} ${metric.accent === 'neon' ? 'glow-neon' : metric.accent === 'cyan' ? 'glow-cyan' : ''}`}>
      {metric.prefix ?? ''}<span
        data-count
        data-target={metric.target}
        data-decimals={metric.decimals ?? 0}
        >0</span
      >{metric.suffix ?? ''}
    </span>
    <span class={`grid h-9 w-9 shrink-0 place-items-center rounded border ${a.border} ${a.bg} ${a.text}`}>
      <Icon name={metric.icon} class="h-4 w-4" />
    </span>
  </div>

  <p class="label relative mt-4 !text-txt-dim">{metric.label}</p>
  <p class="relative mt-1.5 text-xs leading-relaxed text-txt-mute">{metric.detail}</p>

  <!-- telemetry bar -->
  <div class="relative mt-4 h-[3px] w-full overflow-hidden rounded-full bg-hud-soft">
    <div
      class="bar-grow h-full rounded-full"
      style={`--bar:1; --bar-delay:${delay + 250}ms; background: linear-gradient(90deg, transparent, var(--color-${metric.accent}))`}
    ></div>
  </div>
</article>

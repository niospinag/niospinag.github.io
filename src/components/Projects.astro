---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import ProjectCard from './ProjectCard.astro';
import { projects, projectsIndexHref } from '../data/profile';
---

<section id="projects" class="relative scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index="03"
      title="Projects & Technical Cases"
      subtitle="Summary of projects and technical experiences. Each case has its own page to include photos, videos, plans and complete descriptions without overloading the homepage."
      note="showcase.cases"
      accent="magenta"
      i18nTitle="projects.title"
      i18nSubtitle="projects.subtitle"
    />

    <div class="grid gap-5 md:grid-cols-2 lg:gap-6">
      {projects.slice(0, 4).map((project, index) => <ProjectCard project={project} delay={index * 90} />)}
    </div>

    <div class="reveal mt-8 flex justify-center">
      <a href={projectsIndexHref()} class="btn btn-outline">
        <span data-i18n-projects-link>View all cases</span>
        <Icon name="lucide:arrow-right" class="h-4 w-4" />
      </a>
    </div>
  </div>
</section>

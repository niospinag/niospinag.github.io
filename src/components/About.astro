---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import { education, profile } from '../data/profile';

const principles = [
  { icon: 'lucide:git-branch', t: 'HW/SW Integration', d: 'Hardware and software integration experience for robotic platforms.' },
  { icon: 'lucide:line-chart', t: 'Fleet Analytics', d: 'Data analysis and tracking of autonomous delivery robot fleets.' },
  { icon: 'lucide:clipboard-check', t: 'Algorithm Validation', d: 'Design of testing platforms for control algorithm validation.' },
  { icon: 'lucide:users', t: 'Engineering Teaching', d: 'Laboratory instructor for 200+ students and university courses.' },
];
---

<section id="about" class="relative scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index="05"
      title="Profile & Education"
      subtitle="Academic background, PMP certification, languages and teaching experience at Universidad Nacional de Colombia."
      note="profile.record"
      accent="amber"
      i18nTitle="about.title"
      i18nSubtitle="about.subtitle"
    />

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <!-- ============ LEFT ============ -->
      <div class="space-y-6">
        <div class="panel corners reveal scanlines relative overflow-hidden p-6 sm:p-7">
          <h3 class="font-display text-lg font-bold uppercase tracking-wide text-amber" data-i18n-about="about.areasTitle">Areas of expertise</h3>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {
              principles.map((p) => (
                <div class="group rounded border border-hud bg-panel-2/60 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-amber/40">
                  <span class="grid h-9 w-9 place-items-center rounded border border-amber/40 bg-amber/10 text-amber">
                    <Icon name={p.icon} class="h-4 w-4" />
                  </span>
                  <p class="mt-3 font-mono text-[13px] font-semibold text-txt">{p.t}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-txt-mute">{p.d}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- languages -->
        <div class="panel corners reveal p-6 sm:p-7" style="--reveal-delay:90ms">
          <h3 class="label mb-5" data-i18n-label="about.languages">languages</h3>
          <div class="grid gap-3 sm:grid-cols-2">
            {
              profile.languages.map((l) => (
                <div class="rounded border border-hud bg-panel-2/60 px-4 py-3">
                  <span class="label block !text-[9px]" data-i18n-label="about.language">language</span>
                  <div class="mt-1.5 flex flex-wrap items-baseline justify-between gap-2">
                    <span class="text-sm font-semibold text-txt">{l.name}</span>
                    <span class="mono text-[10px] text-txt-dim">{l.level}</span>
                  </div>
                </div>
              ))
            }
          </div>

          <h3 class="label mb-4 mt-7" data-i18n-label="about.certifications">certifications</h3>
          <div class="flex flex-wrap gap-2">
            {
              profile.certifications.map((c) => (
                <span class="chip !py-2">
                  <Icon name={c.icon} class="h-3.5 w-3.5 text-amber" />
                  <span class="text-txt">{c.name}</span>
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- ============ RIGHT: EDUCATION ============ -->
      <div class="space-y-6">
        <div class="panel corners reveal p-6 sm:p-7" style="--reveal-delay:60ms">
          <h3 class="label mb-5" data-i18n-label="about.education">education</h3>
          <ol class="relative space-y-6 border-l border-hud pl-6">
            {
              education.map((e) => (
                <li class="relative">
                  <span class="absolute -left-[29px] top-1 grid h-4 w-4 place-items-center rounded-full border-2 border-amber/60 bg-void">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
                  </span>
                  <div class="flex items-start gap-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded border border-amber/40 bg-amber/10 text-amber">
                      <Icon name={e.icon} class="h-4 w-4" />
                    </span>
                    <div class="min-w-0">
                      <p class="font-display text-[15px] font-bold leading-snug text-txt">{e.degree}</p>
                      <p class="mt-1 text-xs text-txt-dim">{e.institution} · {e.location}</p>
                      <p class="mono mt-1.5 inline-block rounded border border-hud bg-panel-2/70 px-2 py-0.5 text-[10px] tabular-nums text-amber">
                        {e.date}
                      </p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <!-- quick facts -->
        <div class="panel corners reveal p-6 sm:p-7" style="--reveal-delay:140ms">
          <h3 class="label mb-4" data-i18n-label="about.quickRecord">quick record</h3>
          <dl class="space-y-3 font-mono text-[12px]">
            {[
              ['name', profile.name],
              ['role', profile.role],
              ['base', profile.location],
              ['email', profile.email],
              ['exp', '+5 years'],
            ].map(([k, v]) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-hud-soft pb-2.5 last:border-0 last:pb-0">
                <dt class="label !text-[9px]">{k}</dt>
                <dd class="truncate text-right text-txt-dim">{v}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- references -->
        <div class="panel corners reveal relative overflow-hidden p-6 sm:p-7" style="--reveal-delay:200ms">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(80%_120%_at_100%_0%,rgba(41,224,255,0.07),transparent_65%)]"></div>
          <div class="relative">
            <p class="label">// references</p>
            <h3 class="mt-2 font-display text-lg font-bold uppercase tracking-wide text-cyan" data-i18n-label="about.references">Professional references</h3>
            <p class="mt-2 text-sm leading-relaxed text-txt-dim" data-i18n-about="about.referencesText">
              Check my LinkedIn profile. Full recommendation letters from former employers available upon request.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-outline !px-3 !py-2">
                <Icon name="lucide:linkedin" class="h-4 w-4" />
                <span data-i18n-about="about.viewLinkedIn">View LinkedIn</span>
                <Icon name="lucide:arrow-up-right" class="h-3 w-3" />
              </a>
              <a
                href={`mailto:${profile.email}?subject=${encodeURIComponent('Recommendation Letter Request')}`}
                class="btn btn-ghost !px-3 !py-2"
              >
                <Icon name="lucide:mail" class="h-4 w-4" />
                <span data-i18n-about="about.requestLetters">Request letters</span>
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

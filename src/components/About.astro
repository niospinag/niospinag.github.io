---
import { Icon } from 'astro-icon/components';
import SectionHeader from './SectionHeader.astro';
import { education, profile } from '../data/profile';

const principles = [
  { icon: 'lucide:git-branch', t: 'Del CAD al campo', d: 'Cierro el ciclo completo: diseño mecánico, firmware, control y validación en entorno real.' },
  { icon: 'lucide:line-chart', t: 'Decisiones con datos', d: 'Toda mejora se instrumenta: telemetría, métricas de impacto y validación repetible.' },
  { icon: 'lucide:shield-check', t: 'Seguridad primero', d: 'Interlocks, redundancias y protocolos seguros en robots que operan cerca de personas.' },
  { icon: 'lucide:users', t: 'Liderazgo técnico', d: 'Certificación PMP y experiencia docente para coordinar equipos y transferir conocimiento.' },
];
---

<section id="about" class="relative scroll-mt-24 py-20 sm:py-28">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <SectionHeader
      index="05"
      title="Perfil & Formación"
      subtitle="Formación académica, certificaciones, idiomas y los principios con los que abordo cada proyecto de ingeniería."
      note="profile.record"
      accent="amber"
    />

    <div class="grid gap-6 lg:grid-cols-[minmax(0,1.05fr)_minmax(0,0.95fr)]">
      <!-- ============ LEFT ============ -->
      <div class="space-y-6">
        <div class="panel corners reveal scanlines relative overflow-hidden p-6 sm:p-7">
          <h3 class="font-display text-lg font-bold uppercase tracking-wide text-amber">Cómo trabajo</h3>
          <div class="mt-5 grid gap-4 sm:grid-cols-2">
            {
              principles.map((p) => (
                <div class="group rounded border border-hud bg-panel-2/60 p-4 transition-all duration-200 hover:-translate-y-0.5 hover:border-amber/40">
                  <span class="grid h-9 w-9 place-items-center rounded border border-amber/40 bg-amber/10 text-amber">
                    <Icon name={p.icon} class="h-4 w-4" />
                  </span>
                  <p class="mt-3 font-mono text-[13px] font-semibold text-txt">{p.t}</p>
                  <p class="mt-1.5 text-xs leading-relaxed text-txt-mute">{p.d}</p>
                </div>
              ))
            }
          </div>
        </div>

        <!-- languages -->
        <div class="panel corners reveal p-6 sm:p-7" style="--reveal-delay:90ms">
          <h3 class="label mb-5">idiomas</h3>
          <div class="space-y-5">
            {
              profile.languages.map((l, i) => (
                <div>
                  <div class="flex items-baseline justify-between">
                    <span class="text-sm text-txt">{l.name}</span>
                    <span class="mono text-[11px] text-txt-mute">{l.level} · {l.value}%</span>
                  </div>
                  <div class="mt-2 h-[4px] overflow-hidden rounded-full bg-hud-soft">
                    <div
                      class="bar-grow h-full rounded-full bg-[linear-gradient(90deg,var(--color-amber),var(--color-neon))]"
                      style={`--bar:${l.value / 100}; --bar-delay:${200 + i * 150}ms`}
                    ></div>
                  </div>
                </div>
              ))
            }
          </div>

          <h3 class="label mb-4 mt-7">certificaciones</h3>
          <div class="flex flex-wrap gap-2">
            {
              profile.certifications.map((c) => (
                <span class="chip !py-2">
                  <Icon name={c.icon} class="h-3.5 w-3.5 text-amber" />
                  <span class="text-txt">{c.name}</span>
                </span>
              ))
            }
          </div>
        </div>
      </div>

      <!-- ============ RIGHT: EDUCATION ============ -->
      <div class="space-y-6">
        <div class="panel corners reveal p-6 sm:p-7" style="--reveal-delay:60ms">
          <h3 class="label mb-5">educación</h3>
          <ol class="relative space-y-6 border-l border-hud pl-6">
            {
              education.map((e) => (
                <li class="relative">
                  <span class="absolute -left-[29px] top-1 grid h-4 w-4 place-items-center rounded-full border-2 border-amber/60 bg-void">
                    <span class="h-1.5 w-1.5 rounded-full bg-amber"></span>
                  </span>
                  <div class="flex items-start gap-3">
                    <span class="grid h-9 w-9 shrink-0 place-items-center rounded border border-amber/40 bg-amber/10 text-amber">
                      <Icon name={e.icon} class="h-4 w-4" />
                    </span>
                    <div class="min-w-0">
                      <p class="font-display text-[15px] font-bold leading-snug text-txt">{e.degree}</p>
                      <p class="mt-1 text-xs text-txt-dim">{e.institution} · {e.location}</p>
                      <p class="mono mt-1.5 inline-block rounded border border-hud bg-panel-2/70 px-2 py-0.5 text-[10px] tabular-nums text-amber">
                        {e.date}
                      </p>
                    </div>
                  </div>
                </li>
              ))
            }
          </ol>
        </div>

        <!-- quick facts -->
        <div class="panel corners reveal p-6 sm:p-7" style="--reveal-delay:140ms">
          <h3 class="label mb-4">registro rápido</h3>
          <dl class="space-y-3 font-mono text-[12px]">
            {[
              ['nombre', profile.name],
              ['rol', profile.role],
              ['base', profile.location],
              ['email', profile.email],
              ['tel', profile.phone],
              ['exp', '+5 años'],
            ].map(([k, v]) => (
              <div class="flex items-baseline justify-between gap-4 border-b border-hud-soft pb-2.5 last:border-0 last:pb-0">
                <dt class="label !text-[9px]">{k}</dt>
                <dd class="truncate text-right text-txt-dim">{v}</dd>
              </div>
            ))}
          </dl>
        </div>

        <!-- references -->
        <div class="panel corners reveal relative overflow-hidden p-6 sm:p-7" style="--reveal-delay:200ms">
          <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(80%_120%_at_100%_0%,rgba(41,224,255,0.07),transparent_65%)]"></div>
          <div class="relative">
            <p class="label">// references</p>
            <h3 class="mt-2 font-display text-lg font-bold uppercase tracking-wide text-cyan">Referencias profesionales</h3>
            <p class="mt-2 text-sm leading-relaxed text-txt-dim">
              Consulta mi perfil de LinkedIn. Las cartas completas de antiguos empleadores están disponibles bajo solicitud.
            </p>
            <div class="mt-4 flex flex-wrap gap-2">
              <a href={profile.links.linkedin} target="_blank" rel="noopener noreferrer" class="btn btn-outline !px-3 !py-2">
                <Icon name="lucide:linkedin" class="h-4 w-4" />
                Ver LinkedIn
                <Icon name="lucide:arrow-up-right" class="h-3 w-3" />
              </a>
              <a
                href={`mailto:${profile.email}?subject=${encodeURIComponent('Solicitud de cartas de recomendación')}`}
                class="btn btn-ghost !px-3 !py-2"
              >
                <Icon name="lucide:mail" class="h-4 w-4" />
                Solicitar cartas
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

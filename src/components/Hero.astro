---
import { Icon } from 'astro-icon/components';
import MetricBadge from './MetricBadge.astro';
import { metrics, profile, sectionHref } from '../data/profile';

const bootLines = [
  { t: '$ portfolio --summary', c: 'text-txt' },
  { t: '[INFO] [profile]  Robotics and AI Software Engineer · Bogotá, Colombia', c: 'text-txt-dim' },
  { t: '[INFO] [career]   5+ years · ML, ROS2, Data Engineering', c: 'text-txt-dim' },
  { t: '[INFO] [stack]    Python · ROS2 · GCP · C++', c: 'text-txt-dim' },
  { t: '[INFO] [CAD]      8 optimized models · 7 screenshots', c: 'text-txt-dim' },
  { t: '[INFO] [projects] 5 projects documented', c: 'text-txt-dim' },
  { t: '[ OK ] portfolio summary ready', c: 'text-neon' },
];

const subsystems = [
  { k: 'ML SUCCESS', v: 85, display: '+35%' },
  { k: 'DATA PIPELINE', v: 100, display: '~1TB' },
  { k: 'SWARM', v: 92, display: '23 bots' },
  { k: 'COLLISION', v: 99, display: '99%' },
];
---

<section id="hero" class="relative flex min-h-screen flex-col justify-center pb-16 pt-28 sm:pt-32">
  <div class="mx-auto w-full max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="grid items-center gap-12 lg:grid-cols-[1.12fr_0.88fr] lg:gap-16">
      <!-- ================= LEFT ================= -->
      <div>
        <div class="reveal flex flex-wrap items-center gap-3">
          <span class="inline-flex items-center gap-2 rounded-full border border-neon/40 bg-neon/10 px-3 py-1 font-mono text-[10px] uppercase tracking-[0.18em] text-neon">
            <span class="relative flex h-1.5 w-1.5">
              <span class="absolute inline-flex h-full w-full animate-ping-slow rounded-full bg-neon"></span>
              <span class="relative inline-flex h-1.5 w-1.5 rounded-full bg-neon"></span>
            </span>
            <span data-i18n-hero-status>{profile.status}</span>
          </span>
          <span class="inline-flex items-center gap-1.5 font-mono text-[10px] uppercase tracking-[0.18em] text-txt-mute">
            <Icon name="lucide:map-pin" class="h-3 w-3" />
            {profile.location} · {profile.timezone}
          </span>
        </div>

        <h1 class="reveal mt-7 font-display text-[clamp(2.6rem,7.5vw,5.25rem)] font-bold leading-[0.95] tracking-tighter" style="--reveal-delay:80ms">
          <span class="block text-txt">NESTOR IVAN</span>
          <span class="glow-neon block text-neon">OSPINA GAITAN</span>
        </h1>

        <p class="reveal mt-5 font-mono text-sm uppercase tracking-[0.22em] text-cyan sm:text-base" style="--reveal-delay:160ms">
          <span data-scramble>{profile.role}</span>
          <span class="ml-2 animate-blink text-neon">▮</span>
        </p>
        <p class="reveal mt-1 font-mono text-[11px] uppercase tracking-[0.22em] text-txt-mute" style="--reveal-delay:200ms">
          // {profile.roleSuffix}
        </p>

        <p class="reveal mt-6 max-w-xl text-base leading-relaxed text-txt-dim sm:text-lg" style="--reveal-delay:240ms">
          {profile.tagline}
        </p>

        <!-- CTAs -->
        <div class="reveal mt-9 flex flex-wrap items-center gap-3" style="--reveal-delay:320ms">
          <a href={sectionHref('projects')} class="btn btn-primary">
            <Icon name="lucide:rocket" class="h-4 w-4" />
            <span data-i18n="hero.exploreProjects">Explore Projects</span>
          </a>
          <a href={sectionHref('viewer')} class="btn btn-outline">
            <Icon name="lucide:box" class="h-4 w-4" />
            <span data-i18n="hero.view3D">View 3D CAD Models</span>
          </a>
          <a href={profile.cv} download class="btn btn-ghost">
            <Icon name="lucide:download" class="h-4 w-4" />
            <span data-i18n="hero.downloadCV">Download CV</span>
          </a>
        </div>

        <!-- quick contact -->
        <div class="reveal mt-8 flex flex-wrap items-center gap-x-6 gap-y-2 font-mono text-xs text-txt-mute" style="--reveal-delay:400ms">
          <a href={`mailto:${profile.email}`} class="group inline-flex items-center gap-2 transition-colors hover:text-neon">
            <Icon name="lucide:mail" class="h-3.5 w-3.5" />
            {profile.email}
          </a>
        </div>
      </div>

      <!-- ================= RIGHT: TELEMETRY TERMINAL ================= -->
      <div class="reveal" style="--reveal-delay:200ms">
        <div class="panel corners scanlines relative overflow-hidden">
          <!-- window bar -->
          <div class="flex items-center gap-2 border-b border-hud bg-panel-2/80 px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-signal/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-amber/80"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-neon/80"></span>
            <span class="ml-3 truncate font-mono text-[10px] text-txt-mute">profile@robotics: ~/overview</span>
            <span class="ml-auto inline-flex items-center gap-1.5 font-mono text-[9px] uppercase tracking-widest text-neon">
              <span class="h-1.5 w-1.5 rounded-full bg-neon"></span> profile
            </span>
          </div>

          <!-- boot log -->
          <div class="relative space-y-2 px-4 py-5 font-mono text-[11px] leading-relaxed sm:px-5 sm:text-xs">
            {
              bootLines.map((l, i) => (
                <p class={`animate-boot opacity-0 ${l.c}`} style={`animation-delay:${400 + i * 260}ms`}>
                  {l.t}
                </p>
              ))
            }
            <p class="animate-boot opacity-0 pt-1 text-txt" style={`animation-delay:${400 + bootLines.length * 260}ms`}>
              $ <span class="animate-blink text-neon">▮</span>
            </p>
          </div>

          <!-- subsystem gauges -->
          <div class="grid grid-cols-2 gap-x-6 gap-y-3 border-t border-hud bg-panel-2/50 px-4 py-4 sm:px-5">
            {
              subsystems.map((s, i) => (
                <div>
                  <div class="flex items-baseline justify-between font-mono text-[10px]">
                    <span class="uppercase tracking-[0.18em] text-txt-mute">{s.k}</span>
                    <span class="tabular-nums text-neon">{s.display}</span>
                  </div>
                  <div class="mt-1.5 h-[3px] overflow-hidden rounded-full bg-hud-soft">
                    <div
                      class="bar-grow h-full rounded-full bg-[linear-gradient(90deg,var(--color-neon-deep),var(--color-neon))]"
                      style={`--bar:${s.v / 100}; --bar-delay:${900 + i * 140}ms`}
                    ></div>
                  </div>
                </div>
              ))
            }
          </div>
        </div>

        <p class="mt-3 text-right font-mono text-[10px] text-txt-mute">
          // professional summary · {profile.timezone}
        </p>
      </div>
    </div>

    <!-- ================= METRICS ================= -->
    <div class="mt-16 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:mt-24 lg:grid-cols-4 lg:gap-5">
      {metrics.map((m, i) => <MetricBadge metric={m} delay={i * 90} />)}
    </div>
  </div>
</section>

<script>
  /* Scramble-decode effect for the role line */
  const GLYPHS = '!<>-_\\/[]{}—=+*^?#01';
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  document.querySelectorAll<HTMLElement>('[data-scramble]').forEach((el) => {
    const final = el.textContent ?? '';
    if (reduce) return;
    const queue = [...final].map((ch, i) => ({
      ch,
      start: Math.floor(i * 1.6),
      end: Math.floor(i * 1.6) + 12 + Math.random() * 10,
    }));
    const t0 = performance.now() + 450;
    const timer = window.setInterval(() => {
      const frame = (performance.now() - t0) / 16.7;
      if (frame < 0) return;
      let out = '';
      let done = 0;
      for (const q of queue) {
        if (frame >= q.end) {
          out += q.ch;
          done++;
        } else if (frame >= q.start) {
          out += GLYPHS[Math.floor(Math.random() * GLYPHS.length)];
        } else {
          out += ' ';
        }
      }
      el.textContent = out;
      if (done >= queue.length) {
        el.textContent = final;
        window.clearInterval(timer);
      }
    }, 30);
  });

  /* Count-up for hero metric badges */
  const counters = document.querySelectorAll<HTMLElement>('[data-count]');
  const animate = (el: HTMLElement) => {
    const target = Number(el.dataset.target ?? 0);
    const decimals = Number(el.dataset.decimals ?? 0);
    if (reduce) {
      el.textContent = target.toFixed(decimals);
      return;
    }
    const dur = 1400;
    const t0 = performance.now();
    const step = (t: number) => {
      const p = Math.min(1, (t - t0) / dur);
      const eased = 1 - Math.pow(1 - p, 3);
      el.textContent = (target * eased).toFixed(decimals);
      if (p < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  if ('IntersectionObserver' in window) {
    const co = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            animate(e.target as HTMLElement);
            co.unobserve(e.target);
          }
        }
      },
      { threshold: 0.4 },
    );
    counters.forEach((c) => co.observe(c));
  } else {
    counters.forEach(animate);
  }
</script>
